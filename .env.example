# Get your free Gemini API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Backend API base URL (used by ChatWidget). Leave empty in production
# if the API is co-hosted, or set to your deployed URL.
VITE_API_URL=http://localhost:3001

# Supabase — student/agent portal. Publishable key is safe in the browser;
# row-level security is what protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
